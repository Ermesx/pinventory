@page "/import"
@rendermode InteractiveServer
@using System.Net
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.Extensions.Options
@using Microsoft.Extensions.ServiceDiscovery
@using Pinventory.Google.Configuration
@using Pinventory.Identity.Tokens
@using Pinventory.Web.ApiClients.Pins.GeneratedCode
@using Pinventory.Web.ApiClients.Pins.GeneratedCode.Contracts
@using Pinventory.Web.Components.Shared
@using Pinventory.Web.SignalR
@using Refit
@using static Shared.AlertMessage

@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@inject IOptions<GooglePlatformOptions> Options
@inject TokenService TokenService
@inject IPinsHttpClient PinsClient
@inject IHttpMessageHandlerFactory MessageHandlerFactory
@inject ServiceEndpointResolver EndPointResolver


<PageTitle>Import Starred Places</PageTitle>

<h1>Import Starred Places</h1>

@if (consentDenied)
{
    <AlertMessage Type="AlertType.Warning" OnDismiss="DismissConsentDenied">
        You denied access to the required Google permission. We cannot import your starred places without it.
    </AlertMessage>
}

@if (!string.IsNullOrEmpty(consentError))
{
    <AlertMessage Type="AlertType.Error" OnDismiss="DismissConsentError">
        Something went wrong during Google consent (error: @consentError). Please try again.
    </AlertMessage>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <AlertMessage Type="AlertType.Error" Message="@errorMessage" OnDismiss="DismissError"/>
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <AlertMessage Type="AlertType.Success" Message="@successMessage" OnDismiss="DismissSuccess"/>
}


<p>
    Before starting the import, please grant the Google permission for accessing your starred places.
</p>

<form class="form-horizontal" action="Google/PerformGoogleDataPortabilityConsent" method="post">
    <div>
        <AntiforgeryToken />
        <input type="hidden" name="ReturnUrl" value="/import" />
        <p>
            <button type="submit" class="btn btn-primary">Grant Google permission</button>
        </p>
    </div>
</form>

<p>
    When access is expired or is revoked, you can renew it from your Google account.
</p>
<a href="https://myaccount.google.com/connections/link?project_number=@Options.Value.ProjectId" target="_blank"><button class="btn btn-primary">Renew access</button></a>

<hr/>

<div class="d-flex gap-2 mb-3">
    <button class="btn btn-success" disabled="@(isProcessing || isImportRunning)" @onclick="OnStartImportAsync">Start
        Import
    </button>
    <button class="btn btn-outline-danger" disabled="@(!isImportRunning || isProcessing)" @onclick="OnCancelImportAsync">
        Cancel Import
    </button>
</div>



@if (hub is not null)
{
    <div class="mt-3">
        <h4>Import Progress</h4>
        @if (importId is not null)
        {
            <p>Import ID: @importId</p>
        }
        @if (!string.IsNullOrEmpty(archiveJobId))
        {
            <p>Archive Job: @archiveJobId</p>
        }
        <p>Status: @statusMessage</p>
        <p>Processed: @processed | Created: @created | Updated: @updated | Failed: @failed | Conflicts: @conflicts</p>
        @if (total > 0)
        {
            var pct = (int)Math.Min(100, Math.Round(processed * 100.0 / total));
            <p>Total: @total | @pct%</p>
        }
    </div>
}

<div class="mt-4">
    <h4>Import Jobs</h4>
    @if (isLoadingJobs)
    {
        <div class="d-flex justify-content-center my-3">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (importJobs is null || importJobs.Count == 0)
    {
        <p class="text-muted">No imports yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>Archive Job</th>
                    <th>State</th>
                    <th>Started</th>
                    <th>Completed</th>
                    <th>Processed/Total</th>
                    <th>Created</th>
                    <th>Updated</th>
                    <th>Failed</th>
                    <th>Conflicts</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var j in importJobs)
                {
                    var started = j.StartedAt?.ToLocalTime().ToString("g");
                    var completed = j.CompletedAt?.ToLocalTime().ToString("g");
                    var pct = j.Total > 0 ? Math.Min(100, (int)Math.Round((double)j.Processed * 100 / j.Total)) : 0;
                    <tr>
                        <td>@(string.IsNullOrWhiteSpace(j.ArchiveJobId) ? "-" : j.ArchiveJobId)</td>
                        <td>@GetStateName(j.State)</td>
                        <td>@(started ?? "-")</td>
                        <td>@(completed ?? "-")</td>
                        <td>@j.Processed/@j.Total (@pct%)</td>
                        <td>@j.Created</td>
                        <td>@j.Updated</td>
                        <td>@j.Failed</td>
                        <td>@j.Conflicts</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>


@code {
    [SupplyParameterFromQuery]
    private bool consentDenied { get; set; }

    [SupplyParameterFromQuery]
    private string? consentError { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private HubConnection? hub;

    private Guid? importId;
    private string? archiveJobId;
    private int processed, created, updated, failed, conflicts;
    private uint total;
    private string statusMessage = "Idle";

    private List<ImportDto> importJobs = new();
    private bool isLoadingJobs;
    private bool isProcessing;
    private bool isImportRunning;
    private string? errorMessage;
    private string? successMessage;

    private record ImportProgressDto(Guid ImportId, string ArchiveJobId, int Processed, int Created, int Updated, int Failed, int Conflicts, uint Total);
    private record ImportCompletedDto(Guid ImportId, string ArchiveJobId);
    private record ImportFailedDto(Guid ImportId, string ArchiveJobId, string Error);

    protected override async Task OnInitializedAsync()
    {
        // Build the authenticated SignalR connection to Pins.Api hub via YARP
        hub = new HubConnectionBuilder()
            .WithUrl("http://api/pins/hubs/imports", options =>
            {
                options.AccessTokenProvider = async () =>
                {
                    var principal = (await AuthState).User;
                    var tokens = await TokenService.GetGoogleTokensAsync(principal);
                    return tokens?.IdToken.Token;
                };
            }, MessageHandlerFactory, EndPointResolver)
            .WithAutomaticReconnect()
            .Build();

        RegisterHandlers();

        try
        {
            await hub.StartAsync();
            statusMessage = "Connected";
        }
        catch (Exception ex)
        {
            statusMessage = $"Connection failed: {ex.Message}";
        }

        await LoadJobsAsync();
    }

    private void RegisterHandlers()
    {
        hub!.On<ImportProgressDto>("ProgressUpdated", dto =>
        {
            if (importId is null || importId == dto.ImportId)
            {
                importId ??= dto.ImportId;
                archiveJobId = dto.ArchiveJobId;
                processed += dto.Processed;
                created += dto.Created;
                updated += dto.Updated;
                failed += dto.Failed;
                conflicts += dto.Conflicts;
                total = dto.Total;
                statusMessage = "Import in progress";
                isImportRunning = true;
                InvokeAsync(StateHasChanged);
            }
        });

        hub!.On<ImportCompletedDto>("ImportCompleted", dto =>
        {
            if (importId == dto.ImportId)
            {
                archiveJobId = dto.ArchiveJobId;
                statusMessage = "Import completed";
                isImportRunning = false;
                _ = InvokeAsync(async () =>
                {
                    await LoadJobsAsync();
                    StateHasChanged();
                });
            }
        });

        hub!.On<ImportFailedDto>("ImportFailed", dto =>
        {
            if (importId is null || importId == dto.ImportId)
            {
                archiveJobId = dto.ArchiveJobId;
                statusMessage = $"Import failed: {dto.Error}";
                isImportRunning = false;
                InvokeAsync(StateHasChanged);
            }
        });
    }

    private void ResetCounters()
    {
        processed = created = updated = failed = conflicts = 0;
        total = 0;
    }

    private async Task LoadJobsAsync()
    {
        isLoadingJobs = true;
        errorMessage = null;

        try
        {
            var jobs = await PinsClient.GetImports();
            importJobs = jobs.OrderByDescending(j => j.StartedAt ?? DateTimeOffset.MinValue).ToList();

            var running = importJobs.FirstOrDefault(j => j.State == 1);
            if (running is not null)
            {
                isImportRunning = true;
                archiveJobId = running.ArchiveJobId;
            }
            else
            {
                isImportRunning = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load import jobs: {ex.Message}";
        }
        finally
        {
            isLoadingJobs = false;
        }
    }

    private async Task OnStartImportAsync()
    {
        if (isImportRunning || isProcessing)
        {
            return;
        }

        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            ResetCounters();
            statusMessage = "Starting import...";
            var id = await PinsClient.StartImport(new StartImportDto());
            archiveJobId = id;
            isImportRunning = true;
            successMessage = "Import started.";
            await LoadJobsAsync();
        }
        catch (ApiException ex) when (ex.StatusCode == HttpStatusCode.Conflict)
        {
            successMessage = "An import is already in progress.";
            await LoadJobsAsync();
            isImportRunning = true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to start import: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnCancelImportAsync()
    {
        if (!isImportRunning || string.IsNullOrWhiteSpace(archiveJobId) || isProcessing)
        {
            return;
        }

        isProcessing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            await PinsClient.CancelImport(archiveJobId!);
            successMessage = "Cancel requested.";
        }
        catch (ApiException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            errorMessage = "No running import was found.";
            isImportRunning = false;
        }
        catch (ApiException ex) when (ex.StatusCode == HttpStatusCode.Conflict)
        {
            errorMessage = "Import could not be cancelled at this stage.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to cancel import: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (hub is not null)
        {
            await hub.DisposeAsync();
        }
    }

    private void DismissConsentDenied()
    {
        consentDenied = false;
    }

    private void DismissConsentError()
    {
        consentError = null;
    }

    private void DismissError()
    {
        errorMessage = null;
    }

    private void DismissSuccess()
    {
        successMessage = null;
    }

    // TODO: Fixed mapping in .net 10
    private static string GetStateName(int state) => state switch
    {
        0 => "Unspecified",
        1 => "In Progress",
        2 => "Complete",
        3 => "Failed",
        4 => "Cancelled",
        _ => "Unknown"
    };
}
